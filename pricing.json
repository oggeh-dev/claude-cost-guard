  "_metadata": {
    "schema": 2,
    "source": "https://platform.claude.com/docs/en/about-claude/pricing",
    "last_verified": "2026-07-27",
    "max_age_days": 45,
    "unit": "USD per 1,000,000 tokens",
    "_why_per_model": "Schema 1 priced by TIER, matching 'opus' as a substring of the model id. That was sound while every Opus release shared a price. It stopped being sound when Opus 4.1 ($15/$75) and Opus 5 ($5/$25) ended up in the same tier 3x apart \u2014 every Opus 5 session was costed at Opus 4.1 rates, so a halt guard configured for $10 fired at roughly $3.30 of real spend. Rates are now per model, with effective-date ranges, because pricing changes on dates (Sonnet 5 on 2026-09-01) and a report must price a session by ITS OWN date or every historical number silently changes overnight.",
    "cache_multipliers": {
      "_note": "Documented multipliers on base input, so only input+output need maintaining per model. Fewer numbers, fewer things to go stale.",
      "write_5m": 1.25,
      "write_1h": 2.0,
      "read": 0.1
    },
    "modifiers": {
      "inference_geo_us": 1.1,
      "web_search_usd_per_1k_requests": 10.0,
      "batch": 0.5
    }
  },
